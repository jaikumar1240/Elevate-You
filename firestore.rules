rules_version = '2';

// All public writes go through the `api` Cloud Function (Admin SDK bypasses rules).
// Browsers can only read/annotate leads when signed in as the admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'jaikumar1240@gmail.com';
    }

    match /leads/{leadId} {
      allow read: if isAdmin();
      // Admin may only edit CRM fields, never funnel/payment data.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['crmStatus', 'notes', 'nextFollowUp', 'crmUpdatedAt']);
    }

    match /payments/{paymentId} {
      allow read: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
