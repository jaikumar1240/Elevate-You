{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "test", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/.*/**",
      "**/*.log",
      "**/node_modules/**",
      "functions/**",
      "public/**",
      "**/server.js",
      "**/setup.sh",
      "**/view_db.py",
      "**/*.db",
      "**/README.md",
      "**/styles.backup.css",
      "firestore.rules",
      "firestore.indexes.json",
      "**/package.json",
      "**/package-lock.json",
      "**/*-full.png",
      "**/*-full.jpg"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "asia-south1" }
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ],
    "headers": [
      {
        "source": "/api/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" }
        ]
      },
      {
        "source": "/admin**",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|webp|ico)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
